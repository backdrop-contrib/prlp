<?php

/**
 * @file
 * Password Reset Landing Page module (Backdrop).
 */

/**
 * Implements hook_menu().
 */
function prlp_menu() {
  $items = array();

  $items['admin/config/people/accounts/prlp'] = array(
    'title' => 'PRLP settings',
    'description' => 'Configure what happens when users use one-time login links for resetting password.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('prlp_admin_settings'),
    'access arguments' => array('administer users'),
    'file' => 'prlp.admin.inc',
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

/**
 * Implements hook_backdrop_goto_alter().
 *
 * (Renamed from hook_drupal_goto_alter() in Backdrop.)
 */
function prlp_backdrop_goto_alter(&$path, &$options, &$http_response_code) {
  if (isset($_SESSION['pass_reset_hash'])) {
    $parts = explode('/', $path);
    if (isset($parts[4]) && $parts[4] === 'confirm' && $parts[0] === 'user' && $parts[1] === 'reset') {
      $_SESSION['prlp_reset_hash'] = $_SESSION['pass_reset_hash'];
    }
  }
}

/**
 * Hide these top-level form keys by default.
 */
define('PRLP_HIDDEN_FIELDS_DEFAULT', "signature_settings\npicture");

/**
 * Hide these account sub-keys by default.
 */
define('PRLP_HIDDEN_ACCOUNT_FIELDS_DEFAULT', "mail");

/**
 * Default redirect after using the reset link.
 */
define('PRLP_DESTINATION_DEFAULT', 'user/%uid/edit');

/**
 * Alters the user password reset landing page to include the account form.
 */
function prlp_form_user_pass_reset_alter(&$form, &$form_state) {
  @list($uid, $timestamp, $hashed_pass, $action) = $form_state['build_info']['args'];

  if ($uid) {
    $form['#user'] = user_load($uid);

    if (empty($action)) {
      // Inject username/email/password UI into the landing page.
      user_account_form($form, $form_state);
      $user_account_form_id = 'user_account_form';
      backdrop_alter(array('form', 'form_user_account_form'), $form, $form_state, $user_account_form_id);

      $form['#user_category'] = 'account';

      // Hide configured top-level elements.
      foreach ($form as $key => &$element) {
        if (in_array($key, prlp_get_hidden_fields(), TRUE)) {
          $element['#access'] = FALSE;
        }
      }
      // Hide configured account sub-elements.
      if (isset($form['account']) && is_array($form['account'])) {
        foreach ($form['account'] as $key => &$element) {
          if (in_array($key, prlp_get_hidden_account_fields(), TRUE)) {
            $element['#access'] = FALSE;
          }
        }
      }

      // Avoid mid-rebuild redirects.
      unset($form['#action']);

      if (isset($_SESSION['prlp_reset_hash']) && empty($form_state['input'])) {
        $_SESSION['pass_reset_hash'] = $_SESSION['prlp_reset_hash'];
      }

      // Tidy the message since password change happens here.
      if (!empty($form['message']['#markup'])) {
        $form['message']['#markup'] = str_replace('<p>Click on this button to log in to the site and change your password.</p>', '', $form['message']['#markup']);
      }

      $required = (int) config_get('prlp.settings', 'prlp_password_required', 1);
      if (is_array($form['account']['pass']) && $required) {
        $form['account']['pass']['#required'] = TRUE;
      }

      // Handle submit.
      $form['#submit'][] = 'prlp_user_pass_reset_submit';
    }
  }
}

/**
 * Submit handler: save changes and finalize login.
 */
function prlp_user_pass_reset_submit($form, &$form_state) {
  global $user;

  @list($uid, $timestamp, $hashed_pass, $action) = $form_state['build_info']['args'];

  if ($hashed_pass === 'confirm') {
    if (isset($_SESSION['prlp_reset_hash'])) {
      $hashed_pass = $_SESSION['prlp_reset_hash'];
      unset($_SESSION['prlp_reset_hash']);
    }
    else {
      backdrop_set_message(t('Could not find password hash; login will likely fail.'), 'warning');
    }
  }

  if ($user->uid) {
    if ($user->uid == $uid) {
      backdrop_set_message(t('You are logged in as %user. <a href="!user_edit">Change your password.</a>', array('%user' => $user->name, '!user_edit' => url("user/$user->uid/edit"))));
    }
    else {
      $reset_link_account = user_load($uid);
      if (!empty($reset_link_account)) {
        backdrop_set_message(t('Another user (%other_user) is already logged in on this computer, but you used a one-time link for %resetting_user. Please <a href="!logout">log out</a> and try again.',
          array(
            '%other_user' => $user->name,
            '%resetting_user' => $reset_link_account->name,
            '!logout' => url('user/logout'),
          )));
      }
      else {
        backdrop_set_message(t('The one-time login link you clicked is invalid.'));
      }
    }
    $form_state['redirect'] = '';
    return;
  }

  $timeout   = (int) config_get('system.core', 'user_password_reset_timeout', 86400);
  $current   = REQUEST_TIME;
  $form_state['values']['roles'] = array_filter($form_state['values']['roles']);

  $users = user_load_multiple(array($uid), array('status' => '1'));
  if ($timestamp <= $current && $account = reset($users)) {
    if ($account->login && $current - $timestamp > $timeout) {
      backdrop_set_message(t('You have tried to use a one-time login link that has expired. Please request a new one.'), 'warning');
      $form_state['redirect'] = 'user/password';
      return;
    }
    elseif ($account->uid && $timestamp >= $account->login && $timestamp <= $current && $hashed_pass == user_pass_rehash($account->pass, $timestamp, $account->login, $account->uid)) {

      // Save profile/account changes inline with the reset.
      $form_state['user'] = $account;
      if (!isset($_SESSION)) {
        $_SESSION = array();
      }
      user_profile_form_submit($form, $form_state);

      // Swap the generic "changes saved" message for our configurable one.
      if (isset($_SESSION['messages']['status'])) {
        $new_msg = $account->access
          ? config_get('prlp.settings', 'prlp_confirmation_message_existing_users', 'Your new password has been saved.')
          : config_get('prlp.settings', 'prlp_confirmation_message_new_users', 'Thank you for setting your password, the registration process has completed.');
        $idx = array_search(t('The changes have been saved.'), $_SESSION['messages']['status']);
        if ($idx !== FALSE) {
          $_SESSION['messages']['status'][$idx] = $new_msg;
          $_SESSION['messages']['status'] = array_filter($_SESSION['messages']['status']);
          if (empty($_SESSION['messages']['status'])) {
            unset($_SESSION['messages']['status']);
          }
        }
      }

      watchdog('user', 'User %name used one-time login link at time %timestamp.', array('%name' => $account->name, '%timestamp' => $timestamp));

      // Reload to drop plain password from memory.
      $user = user_load($account->uid);
      user_login_finalize();

      // Allow editing without current pass.
      $token = drupal_hash_base64(drupal_random_bytes(55));
      $_SESSION['pass_reset_' . $user->uid] = $token;

      // Destination logic (supports %uid and query args).
      $destination = config_get('prlp.settings', 'prlp_destination', PRLP_DESTINATION_DEFAULT);
      if (empty($destination) || $destination == PRLP_DESTINATION_DEFAULT) {
        $form_state['redirect'] = array('user/' . $user->uid . '/edit', array('query' => array('pass-reset-token' => $token)));
      }
      else {
        $destination = str_replace('%uid', $user->uid, $destination);
        $destination = drupal_parse_url($destination);
        // Preserve any existing query and append token.
        $destination['query'] = isset($destination['query']) ? $destination['query'] : array();
        $destination['query']['pass-reset-token'] = $token;
        $form_state['redirect'] = array($destination['path'], $destination);
      }
      return;
    }
    else {
      backdrop_set_message(t('You have tried to use a one-time login link that has either been used or is no longer valid. Please request a new one.'), 'warning');
      $form_state['redirect'] = 'user/password';
      return;
    }
  }
  else {
    // Deny access (details in watchdog for admins).
    backdrop_access_denied();
  }
}

/**
 * Returns an array of fields under $form that should be hidden in PRLP form.
 */
function prlp_get_hidden_fields() {
  $raw = (string) config_get('prlp.settings', 'prlp_hidden_fields', PRLP_HIDDEN_FIELDS_DEFAULT);
  $lines = preg_split('/\r\n|\r|\n/', $raw);
  return array_values(array_filter(array_map('trim', $lines), 'strlen'));
}

/**
 * Returns an array of fields on $form['account'] that should be hidden by PRLP.
 */
function prlp_get_hidden_account_fields() {
  $raw = (string) config_get('prlp.settings', 'prlp_hidden_account_fields', PRLP_HIDDEN_ACCOUNT_FIELDS_DEFAULT);
  $lines = preg_split('/\r\n|\r|\n/', $raw);
  return array_values(array_filter(array_map('trim', $lines), 'strlen'));
}

/**
 * Implements hook_module_implements_alter().
 *
 * Keep Password Policy alterations after PRLP adds the password element.
 */
function prlp_module_implements_alter(&$implementations, $hook) {
  if (module_exists('password_policy') && $hook === 'form_alter') {
    $group = $implementations['password_policy'];
    unset($implementations['password_policy']);
    $implementations['password_policy'] = $group;
  }
}
